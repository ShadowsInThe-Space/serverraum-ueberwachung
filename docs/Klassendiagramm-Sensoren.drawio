        <!-- Legend -->
        <mxCell id="legend" value="Legende:&#xa;───── erstellt/prüft&#xa;- - - - - nutzt/verwendet&#xa;&#xa;Farben:&#xa;■ Hellblau = Datenstruktur&#xa;■ Gelb = Enum/Konstanten&#xa;■ Rosa = Alarm-Konfiguration&#xa;■ Grün = Datenbank-Entity&#xa;■ Orange = Alarm-Engine" style="text;html=1;strokeColor=#000000;fillColor=#F5F5F5;align=left;verticalAlign=top;spacing=5;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
