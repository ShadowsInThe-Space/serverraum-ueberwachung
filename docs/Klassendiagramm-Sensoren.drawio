        <mxCell id="rel5" value="erstellt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#FF0000;fontSize=10;" edge="1" parent="1" source="alarm_engine" target="alarm_class">
          <mxGeometry relative="1" as="geometry" />
