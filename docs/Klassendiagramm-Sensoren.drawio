        <!-- ========== RELATIONSHIPS ========== -->

        <!-- SensorDaten uses SensorTypen -->
        <mxCell id="rel1" value="verwendet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;endFill=0;strokeColor=#000000;fontSize=10;dashed=1;" edge="1" parent="1" source="sensor_data" target="sensor_types">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SensorDaten triggers Alarm -->
        <mxCell id="rel2" value="prüft&#xa;Schwellwerte" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#FF0000;fontSize=10;" edge="1" parent="1" source="sensor_data" target="alarm_engine">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="250" as="sourcePoint" />
            <mxPoint x="600" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- AlarmEngine uses AlarmKonfiguration -->
        <mxCell id="rel3" value="lädt&#xa;Konfiguration" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;endFill=0;strokeColor=#000000;fontSize=10;dashed=1;" edge="1" parent="1" source="alarm_engine" target="alarm_config">
          <mxGeometry relative="1" as="geometry" />
