        <mxCell id="wf4-grp2" value="Benachrichtigungen&#xa;─────────────────&#xa;☑ E-Mail bei Alarm&#xa;  Empfänger: [admin@firma.de]&#xa;☑ Telegram Benachrichtigung&#xa;  Chat-ID:   [@serverraum_bot]&#xa;&#xa;☑ LED bei Alarm einschalten&#xa;☑ Buzzer bei kritischen Alarmen" style="text;html=1;strokeColor=#dddddd;fillColor=#f9f9f9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=5;fontSize=10;fontColor=#333333;spacingLeft=5;" vertex="1" parent="1">
