        <mxCell id="r1-why" value="Nur eine DB-Connection + ein MQTT-Listener nötig. Singleton verhindert Ressourcenkonflikte und garantiert einen einzigen Zugriffspunkt für Datenbank und MQTT." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="550" height="100" as="geometry" />
