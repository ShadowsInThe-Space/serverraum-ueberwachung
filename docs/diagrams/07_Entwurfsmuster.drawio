        </mxCell>
        <mxCell id="r2-why" value="Jeder Sensor hat eine andere Hardware-Schnittstelle (OneWire, I2C, Analog). Strategy ermöglicht einheitliche readValue()-API. Neue Sensoren sind einfach hinzuzufügen ohne SensorManager zu ändern." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="800" y="210" width="550" height="100" as="geometry" />
        </mxCell>
        
