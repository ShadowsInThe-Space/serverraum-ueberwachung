        </mxCell>
        <mxCell id="r3-why" value="MQTT basiert auf Publish/Subscribe. ESP32 publishet Daten, Backend subscribed Topics. Entkoppelt Sender (Sensor) vom Empfänger (Alarm). Einfach weitere Subscriber hinzufügen (Logging, Analytics)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="800" y="320" width="550" height="100" as="geometry" />
        </mxCell>
        
