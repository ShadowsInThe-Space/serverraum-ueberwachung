        <!-- Info Box -->
        <mxCell id="info" value="OOP-Polymorphie in ESP32-Firmware:&#xa;- Abstrakte Basisklasse 'Sensor' definiert Interface&#xa;- Konkrete Klassen implementieren init() und messen()&#xa;- SensorManager verwaltet Sensor* Array&#xa;- Polymorpher Zugriff: Sensor* kann beliebigen Sensor halten&#xa;&#xa;Siehe auch: main.cpp für die Initialisierung" style="text;html=1;strokeColor=#000000;fillColor=#F0F8FF;align=left;verticalAlign=top;spacing=5;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
